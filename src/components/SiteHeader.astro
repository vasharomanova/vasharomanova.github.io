---
import { uk } from '../content/uk';

const { lead, first, last, highlight } = uk.brand;
const letters = [...last].map((char, i) => ({ char, mova: highlight.includes(i) }));
---

<header class="site-header">
	<div class="container">
		<a href="#top" class="brand" aria-label={`${lead} ${first} ${last}`}>
			<span class="move">{lead}</span> <span class="fade">{first}</span> <span class="last">{letters.map((l) => <span class={l.mova ? 'mova move' : 'fade'}>{l.char}</span>)}</span>
		</a>
	</div>
</header>

<script>
	// Scroll progress --p (0..1) fades the name and slides "Vasha" + "mova" into a centered "Vasha mova".
	const header = document.querySelector<HTMLElement>('.site-header')!;
	const brand = header.querySelector<HTMLElement>('.brand')!;
	const moves = [...brand.querySelectorAll<HTMLElement>('.move')];
	const firstFade = brand.querySelector<HTMLElement>('.fade')!;

	// offsetLeft ignores transforms, so measuring works at any scroll position.
	const measure = () => {
		const space = firstFade.offsetLeft - (moves[0].offsetLeft + moves[0].offsetWidth);
		const total = moves.reduce((w, el) => w + el.offsetWidth, space);
		const box = header.querySelector('.container')!.getBoundingClientRect();
		let x = box.left + box.width / 2 - total / 2 - brand.getBoundingClientRect().left;
		moves.forEach((el, i) => {
			el.style.setProperty('--dx', `${x - el.offsetLeft}px`);
			x += el.offsetWidth + (i === 0 ? space : 0);
		});
	};
	const update = () => header.style.setProperty('--p', Math.min(scrollY / 160, 1).toFixed(3));

	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		measure();
		document.fonts.ready.then(measure);
		addEventListener('resize', measure);
		// Fallback for browsers without CSS scroll timelines.
		if (!CSS.supports('animation-timeline: scroll()')) {
			update();
			addEventListener('scroll', update, { passive: true });
		}
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 20px 0;
		background: var(--bg);
	}

	.brand {
		position: relative;
		white-space: nowrap;
		font: 700 1.05rem/1.2 var(--font-head);
		letter-spacing: 0.01em;
		text-decoration: none;
	}

	.move,
	.fade {
		display: inline-block;
	}

	.move {
		color: color-mix(in srgb, var(--primary-btn) calc(var(--p, 0) * 100%), var(--text));
		transform: translateX(calc(var(--p, 0) * var(--dx, 0px)));
	}

	.fade {
		opacity: calc(1 - var(--p, 0));
	}

	/* Browser-driven scroll animation: stays in sync with iOS Safari scrolling, where scroll events lag. */
	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: scroll()) {
			.move,
			.fade {
				/* Longhands only: the minifier collapses the shorthand + timeline into `animation: none`. */
				animation-timing-function: linear;
				animation-fill-mode: both;
				animation-timeline: scroll(root);
				animation-range: 0 160px;
			}

			.move {
				animation-name: to-mova;
			}

			.fade {
				animation-name: fade-out;
			}
		}
	}

	@keyframes to-mova {
		to {
			color: var(--primary-btn);
			transform: translateX(var(--dx, 0px));
		}
	}

	@keyframes fade-out {
		to {
			opacity: 0;
		}
	}
</style>
