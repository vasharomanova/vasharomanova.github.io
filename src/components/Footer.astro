---
import { uk } from '../content/uk';
import TelegramButton from './TelegramButton.astro';
---

<footer class="footer">
	<div class="container">
		<TelegramButton />
		<p>{uk.footer.note}</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--text);
		color: var(--bg);
		padding: 48px 0 40px;
		text-align: center;
	}

	.footer p {
		margin: 20px auto 0;
		font-size: 0.9rem;
		opacity: 0.8;
	}
</style>
